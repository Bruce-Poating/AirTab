{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "26.06.01",
  "description": "__MSG_extDescription__",
  "author": "Bruce-Poating",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/Bruce-Poating/FlashTab",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "bookmarks"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
